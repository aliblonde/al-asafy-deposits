# Tracking Sub-Application Modern Security Rules
Options -Indexes
DirectoryIndex index.php

<FilesMatch "\.(log|sql|md|jsonl|env|git|sh|htaccess|htpasswd|bak|old|gz|zip)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^onlineview/([^/]+)/?$ onlineview.php?code=$1 [L,QSA,NE]
</IfModule>
