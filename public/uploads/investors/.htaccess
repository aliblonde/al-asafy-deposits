# Upload Directory Execution Protection (Apache 2.4)
<FilesMatch "\.(php|php3|php4|php5|phtml|phps|pl|py|cgi|sh|asp|aspx|exe|bat|cmd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
Options -Indexes
