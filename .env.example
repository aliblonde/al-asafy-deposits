# AL-ASAFY GROUP — Environment Configuration Template
# Copy this file to .env on your server and populate with production credentials.

# ── Primary Deposits Application Database Credentials ──
ASAFY_DB_HOST=localhost
ASAFY_DB_NAME=alasisfh_al_asafy_deposits
ASAFY_DB_USER=alasisfh_alasafy
ASAFY_DB_PASSWORD=YOUR_STRONG_ROATED_DB_PASSWORD
ASAFY_DB_CHARSET=utf8mb4

# ── Tracking Application Database Credentials ──
TRACKING_DB_HOST=localhost
TRACKING_DB_NAME=alasisfh_tracking
TRACKING_DB_USER=alasisfh_tracking_user
TRACKING_DB_PASSWORD=YOUR_STRONG_ROATED_TRACKING_DB_PASSWORD
TRACKING_DB_CHARSET=utf8mb4

# ── Application Environment Settings ──
APP_ENV=production
APP_DEBUG=false
